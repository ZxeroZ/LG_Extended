    <string name="swivel_home_initial_guide_add_rearrange_sub_description_01">ஹோம் ஸ்க்ரீன் இலிருந்து ஸ்வைப் செய்வதன் மூலம் பயன்பாடுகளைச் சேர்க்க முடியுமா என்று பாருங்கள். %s ஐச் சேர்ப்பதற்கான பயன்பாட்டு டிராயரில், எந்தவொரு பயன்பாட்டிலும் தொட்டு பிடித்திருக்கவும் செய்யுங்கள்.</string>
    <string name="swivel_home_initial_guide_add_rearrange_sub_description_02">பயன்பாட்டை மறுசீரமைக்க, பயன்பாட்டில் தொட்டு பிடித்திருக்கவும் செய்து இடது அல்லது வலது பக்கமாக இழுக்கவும்.</string>
    <string name="swivel_home_initial_guide_add_rearrange_sub_title_01">பயன்பாடுகளை %s இல் சேர்க்கவும்</string>
    <string name="swivel_home_initial_guide_add_rearrange_sub_title_02">%s இல் பயன்பாடுகளை மறுசீரமைக்கவும்</string>
    <string name="swivel_home_initial_guide_add_rearrange_title">பயன்பாடுகளைச் சேர்த்து மறுசீரமைக்கவும்</string>
    <string name="swivel_home_initial_guide_intro_description_main_first">ஊசல் ஆதரவு செயலிகளுக்காக, நீங்கள் ஊசலாடச் செய்ய விரும்பும் செயலியை நீங்கள் எளிதில் கண்டுபிடிக்கலாம்.\n\nவேறொரு திரையில் பலதரப்பட்ட பணிகளை மேற்கொள்ளும்போது செயலியைத் திறந்து ஆழ்ந்து அனுபவிக்கவும்.</string>
    <string name="swivel_home_initial_guide_intro_title">%sஐ அறிமுகப்படுத்துகிறோம்</string>
    <string name="swivel_home_initial_guide_second_screen_description_main" formatted="false">செட்டிங்சில் எந்த செயலிகள் %sல் திறக்கவேண்டும் என்பதை நீங்கள் தேர்ந்தெடுக்கலாம்.\n\nசில செயலிகள் %sயில் இருந்து திறக்க முடியாது அல்லது முறையாகத் திரையில் காண்பிக்கமுடியாத.</string>
    <string name="swivel_home_initial_guide_second_screen_description_main_full">அமைப்புகளில் இரண்டாவது திரையில் எந்த பயன்பாடுகள் திறக்கப்படும் என்பதை நீங்கள் தேர்ந்தெடுக்கலாம்.\n\nசில பயன்பாடுகளை இரண்டாவது திரையில் இருந்து திறக்கவோ அல்லது திரையில் சரியாகக் காட்டவோ முடியாது.</string>
    <string name="swivel_home_initial_guide_second_screen_description_title">%s ஆப்ஸ்</string>
    <string name="swivel_home_initial_guide_swing_mode_description_main_first">இரண்டு திரைகளிலும் ஒரு பயன்பாட்டை நீட்டிக்கவும் அல்லது ஒவ்வொரு திரையிலும் தனி பயன்பாட்டைத் திறக்கவும்.</string>
    <string name="swivel_home_initial_guide_swing_mode_sub_description_01">கேமரா மற்றும் கேலரி போன்ற இரண்டு திரைகளிலும் சில பயன்பாடுகளைக் காட்டலாம். மற்ற திரையில் அதைக் கட்டுப்படுத்தும் போது நீங்கள் திரைப்படத்தையும் பார்க்கலாம். விளையாடுங்கள், நீங்கள் விளையாடும்போது, கேம் கருவிகள் ஐப் பயன்படுத்தவும்.</string>
    <string name="swivel_home_initial_guide_swing_mode_sub_description_02">திரைகளில் காண்பிக்க ஒரு ஜோடி பயன்பாடுகளைத் திறக்கவும். குறுக்குவழியை %s மற்றும் அதன் ஹோம் ஸ்க்ரீன் இல் சேர்க்க, எந்த வெற்று இடத்திலும் தொட்டு பிடித்திருக்கவும் செய்யுங்கள்.</string>
