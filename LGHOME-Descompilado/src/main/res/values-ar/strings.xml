    <string name="swivel_home_initial_guide_add_rearrange_sub_description_01">‏انظر التطبيقات التي يمكنك إضافتها عن طريق التمرير إلى أعلى من الشاشة الرئيسية. المس واستمر في اللمس اي تطبيق في حافظة التطبيقات لإضافته إلى %s.</string>
