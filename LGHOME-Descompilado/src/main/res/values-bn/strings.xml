    <string name="initial_guide_desc_customizing_the_home_screen_sub_3">অন্যান্য সেটিংস পরিবর্তন বা অ্যাপ সাজানোর জন্য হোমস্ক্রীন সেটিংসে যান।</string>
    <string name="initial_guide_desc_customizing_the_home_screen_sub_4">সাম্প্রতিক আনইনস্টল করা অ্যাপ পুনরায় ইনস্টল করুন।</string>
    <string name="initial_guide_desc_managing_apps">অ্যাপ বা উইজেট সরাতে, এটিকে স্পর্শ করে ধরে রাখুন এবং যেখানে সরাতে চান সেখানে নিয়ে যান।\nআপনি যদি অন্য কোনো অ্যাপের উপর অ্যাপ সরান তাহলে আপনি তৈরি করতে পারেন।</string>
    <string name="initial_guide_desc_ux6_home_screen_Last">যদি আপনি পৃথক অ্যাপ ড্রয়ার ব্যবহার করতে চান, তাহলে হোম স্ক্রীন সেটিংসে হোম ও অ্যাপ ড্রয়ার নির্বাচন করুন।</string>
    <string name="initial_guide_desc_ux6_home_screen_Main">আপনি বাঁদিকে বা ডানদিকে সোয়াইপ করে হোম স্ক্রীনে থাকা আপনার সব অ্যাপগুলি অন্বেষণ করতে পারেন।</string>
    <string name="initial_guide_desc_ux6_home_screen_sub1">একটি অ্যাপের অনুসন্ধান করতে, Google অনুসন্ধান ব্যবহার করুন।</string>
