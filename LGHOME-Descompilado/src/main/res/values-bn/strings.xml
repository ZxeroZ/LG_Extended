    <string name="initial_guide_desc_app_drawer_Main">আপনি হোম স্ক্রীন অনুসরণ করতে পারেন।</string>
    <string name="initial_guide_desc_apps_on_the_home_screen_att_PrDdefault">আপনি একবার সোয়াইপ করেই হোম স্ক্রীনে সমস্ত অ্যাপ এক্সপ্লোর করতে পারেন। অ্যাপ খুঁজতে, Google অনুসন্ধান ব্যবহার করুন বা আপনার অ্যাপগুলিকে নাম দিয়ে বাছাই করুন।\nহোম স্ক্রীন সেটিংসে, হোম স্ক্রীনে কতগুলি অ্যাপ থাকবে তা পাল্টাতে আপনি গ্রিডের মার পরিবর্তন করতে পারেন।</string>
    <string name="initial_guide_desc_apps_on_the_home_screen_att_PrDtablet">আপনি একবার সোয়াইপ করেই হোম স্ক্রীনে সমস্ত অ্যাপ এক্সপ্লোর করতে পারেন। অ্যাপ খুঁজতে, Google অনুসন্ধান ব্যবহার করুন বা আপনার অ্যাপগুলিকে নাম দিয়ে বাছাই করুন।</string>
    <string name="initial_guide_desc_customizing_the_home_screen">নিম্নলিখিত বিষয় করতে হোম স্ক্রিনের খালি স্থানে স্পর্শ করে ধরে থাকুন।</string>
    <string name="initial_guide_desc_customizing_the_home_screen_sub_1">উইজেট যোগ বা অপসারণ করুন।</string>
