    <string name="swivel_home_initial_guide_add_rearrange_sub_description_01">Posunutím prsta nahor od položky Základná obrazovka uvidíte, či môžete pridať aplikácie. V zásuvke aplikácie na pridanie aplikácie do %s urobte v ľubovoľnej aplikácii znak dotyk a podržanie.</string>
    <string name="swivel_home_initial_guide_add_rearrange_sub_description_02">Ak chcete zmeniť usporiadanie aplikácií, ťuknutím držte aplikáciu a potom ju pretiahnite doľava, alebo doprava.</string>
    <string name="swivel_home_initial_guide_add_rearrange_sub_title_01">Pridanie aplikácie na %s</string>
    <string name="swivel_home_initial_guide_add_rearrange_sub_title_02">Usporiadajte aplikácie na %s</string>
    <string name="swivel_home_initial_guide_add_rearrange_title">Pridať a usporiadať aplikácie</string>
    <string name="swivel_home_initial_guide_intro_description_main_first">Pre používanie podporovaných aplikácii v režime Swivel, vyberte požadovanú aplikáciu pohybom prsta.\n\nOtvorte aplikáciu a užívajte si pohlcujúci zážitok pri multitaskingu na inej obrazovke.</string>
    <string name="swivel_home_initial_guide_intro_title">Predstavenie %s</string>
    <string name="swivel_home_initial_guide_second_screen_description_main" formatted="false">V ponuke Nastavenia si môžete vybrať, ktoré aplikácie sa otvoria na %s.\n\nNiektoré aplikácie nie je možné na %s otvoriť, alebo sa na nej nemusia zobrazovať správne.</string>
    <string name="swivel_home_initial_guide_second_screen_description_main_full">V ponuke Nastavenia si môžete vybrať, ktoré aplikácie sa otvoria na Sekundárna obrazovka.\n\nNiektoré aplikácie nie je možné na Sekundárna obrazovka otvoriť, alebo sa na nej nemusia zobrazovať správne.</string>
    <string name="swivel_home_initial_guide_second_screen_description_title">%s a aplikácie</string>
    <string name="swivel_home_initial_guide_swing_mode_description_main_first">Rozšírte aplikáciu na obe obrazovky alebo otvorte samostatnú aplikáciu na každej obrazovke.</string>
    <string name="swivel_home_initial_guide_swing_mode_sub_description_01">Niektoré aplikácie sa dajú zobraziť na oboch obrazovkách, napríklad Fotoaparát a Galéria. Môžete tiež sledovať film a zároveň ho ovládať na druhej obrazovke. Zahrajte si hru a zatiaľ čo budete hrať, použite Herné nástroje.</string>
    <string name="swivel_home_initial_guide_swing_mode_sub_description_02">Na obrazovkách sa bude zobrazovať dvojica otvorených aplikácií. Ak chcete pridať zástupcu %s, ťuknite a podržte prst na niektorom prázdnom mieste tejto Domovské obrazovky.</string>
