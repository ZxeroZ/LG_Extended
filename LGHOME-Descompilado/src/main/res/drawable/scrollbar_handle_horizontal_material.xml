<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/scroll_bar_handle_inset_left"
    android:insetRight="@dimen/scroll_bar_handle_inset_right"
    android:insetTop="@dimen/scroll_bar_handle_inset_top"
    android:insetBottom="@dimen/scroll_bar_handle_inset_bottom">
    <shape
        android:tint="@color/scroll_bar_handle_color"
        android:shape="rectangle">
        <corners android:radius="@dimen/scroll_bar_handle_radius"/>
        <solid android:color="@android:color/black"/>
        <size android:height="@dimen/scroll_bar_handle_height"/>
    </shape>
</inset>
