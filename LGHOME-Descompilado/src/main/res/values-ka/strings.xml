    <string name="swivel_home_initial_guide_intro_description_main_first">საქვეყნოდ მხარდაჭერილი პროგრამებისთვის, გადაადგილების საშუალებით შეგიძლიათ მარტივად იპოვოთ თქვენთვის სასურველი აპი.\n\nგახსენით აპლიკაცია და ისიამოვნეთ იმერული გამოცდილებით, როდესაც სხვა ეკრანზე მრავალჯერადი დავალება გაქვთ.</string>
    <string name="swivel_home_initial_guide_intro_title">%s შესავალი</string>
    <string name="swivel_home_initial_guide_second_screen_description_main" formatted="false">პარამეტრებში, თქვენ შეგიძლიათ აირჩიოთ რომელი პროგრამები გაიხსნება %s.\n\nზოგიერთი აპლიკაციის გახსნა შეუძლებელია %s ან შეუძლებელია ეკრანზე სწორად გამოსახვა.</string>
    <string name="swivel_home_initial_guide_second_screen_description_main_full">პარამეტრებში, თქვენ შეგიძლიათ აირჩიოთ რომელი პროგრამები გაიხსნება მეორადი ეკრანი.\n\nზოგიერთი აპლიკაციის გახსნა შეუძლებელია მეორადი ეკრანი ან შეუძლებელია ეკრანზე სწორად გამოსახვა.</string>
    <string name="swivel_home_initial_guide_second_screen_description_title">%s პროგრამები</string>
    <string name="swivel_home_initial_guide_swing_mode_description_main_first">გააფართოეთ აპი ორივე ეკრანზე ან გახსენით ცალკე აპი თითოეული ეკრანზე.</string>
    <string name="swivel_home_initial_guide_swing_mode_sub_description_01">ზოგიერთი აპი შესაძლოა ორივე ეკრანზე გამოჩნდეს, როგორც კამერა და გალერეა. შეგიძლიათ ასევე უყუროთ ფილმს და თან აკონტროლოთ ის მეორე ეკრანზე. ითამაშეთ თამაში და თამაშსას გამოიყენეთ თამაშის ხელსაწყოები.</string>
    <string name="swivel_home_initial_guide_swing_mode_sub_description_02">გახსენით ორიოდე აპი ეკრანზე საჩვენებლად. %s-ზე მალსახმობის დასამატებლად შეეხეთ და შეინარჩუნეთ დაჭერილ მდგომარეობაში ნებისმიერი ცარიელ ადგილს მის მთავარი ეკრანი-ზე.</string>
