<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <CheckBox
        android:textSize="0x20c012e"
        android:textStyle="bold"
        android:textColor="0x2080105"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/action_bar_select_checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/iconchange_select_all"
        android:paddingStart="16dp"
        style="?android:attr/actionBarTheme"/>
    <TextView
        android:textSize="0x20c0124"
        android:textColor="0x2080105"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/action_bar_select_item_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recently_uninstalled_selected_count"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        style="?android:attr/actionBarTheme"/>
</FrameLayout>
