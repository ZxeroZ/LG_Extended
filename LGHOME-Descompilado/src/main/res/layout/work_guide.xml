<?xml version="1.0" encoding="utf-8"?>
<com.lge.launcher3.views.WorkGuideView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/work_guide_view"
    android:layout_width="@dimen/overview_guide_width"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/overview_guide_min_height"
    android:layoutDirection="locale"
    android:backgroundTint="0x20800e4">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/work_guide_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="0x20c0123"
            android:textColor="@color/white_color"
            android:id="@+id/work_guide_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/overview_guide_layout_marginTop"
            android:layout_marginBottom="@dimen/overview_guide_layout_marginBottom"
            android:text="@string/work_profile_edu_work_apps"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/overview_guide_text_margin_start"
            android:layout_marginEnd="@dimen/overview_guide_text_margin_end"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/remove_workGuide_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clear_meterial"
            android:contentDescription="@string/app_trash_close"
            android:layout_marginEnd="@dimen/overview_guide_badge_margin_end"/>
    </LinearLayout>
</com.lge.launcher3.views.WorkGuideView>
