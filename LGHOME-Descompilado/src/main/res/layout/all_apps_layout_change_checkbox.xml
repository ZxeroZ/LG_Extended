<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/hig_intercomponent_margin_vertical"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/iconsize_change_layout_image_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/lg_homescreen_popup_arrow"/>
    <ImageView
        android:id="@+id/iconsize_change_layout_image_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
