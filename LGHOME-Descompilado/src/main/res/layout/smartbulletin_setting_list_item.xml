<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/smartbulletin_list_padding"
    android:paddingBottom="@dimen/smartbulletin_list_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/drag_handle"
        android:background="@drawable/smartbulletin_ic_rearrange_tint"
        android:layout_width="@dimen/smartbulletin_item_icon_size"
        android:layout_height="@dimen/smartbulletin_item_icon_size"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/smartbulletin_list_horizontal_margin"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/drag_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="@dimen/smartbulletin_list_padding_start"
        android:paddingEnd="@dimen/smartbulletin_list_padding_end"/>
    <Switch
        android:layout_gravity="end"
        android:id="@+id/providerName"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/smartbulletin_item_height"
        android:paddingStart="@dimen/smartbulletin_list_horizontal_margin"
        android:paddingEnd="@dimen/smartbulletin_list_horizontal_margin"/>
</FrameLayout>
