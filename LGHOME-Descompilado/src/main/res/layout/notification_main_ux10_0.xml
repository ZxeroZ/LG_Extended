<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.notification.NotificationMainView xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="@dimen/notification_elevation">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/text_and_background"
        android:background="@color/popup_background_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/notification_padding_start_ux10_0"
        android:paddingEnd="@dimen/notification_main_text_padding_end_swivel">
        <TextView
            android:textSize="0x20c0181"
            android:textColor="@color/app_shortcut_text_color_black_ux10_0"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="sans-serif"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="0x20c0173"
            android:textColor="@color/app_shortcut_text_color_gray_ux10_0"
            android:ellipsize="end"
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="sans-serif"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <View
        android:layout_gravity="start|center_vertical"
        android:id="@+id/popup_item_icon"
        android:layout_width="@dimen/notification_icon_size_ux10_0"
        android:layout_height="@dimen/notification_icon_size_ux10_0"
        android:layout_marginStart="@dimen/notification_padding_ux10_0"
        android:layout_marginEnd="@dimen/notification_padding_ux10_0"/>
</com.android.launcher3.notification.NotificationMainView>
