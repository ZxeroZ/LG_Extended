<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="@dimen/app_icon_grid_margin"
    android:paddingTop="@dimen/app_icon_grid_margin"
    android:paddingRight="@dimen/app_icon_grid_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingEnd="@dimen/app_icon_grid_margin">
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/app_icon_width"
        android:layout_height="@dimen/app_icon_height"
        android:layout_marginTop="@dimen/app_icon_top_margin"/>
    <TextView
        android:textSize="@dimen/app_icon_text_size"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/app_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/app_icon_text_top_margin"
        android:maxLines="2"
        android:minLines="2"/>
</LinearLayout>
