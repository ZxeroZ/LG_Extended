<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.lge.lgdynamicactionbar.CoordinatorLayout xmlns:lge="http://schemas.android.com/apk/res/com.lge"
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:foreground="0x20202d4"
        android:layout_weight="1">
        <include layout="@layout/launcher_app_bar"/>
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="fill_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            lge:layout_behavior="0x20d016f">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/smartbulletin_switch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/switch_bar_height"
                    layout="@layout/smartbulletin_switch_layout"/>
                <LinearLayout
                    android:background="?android:attr/colorForeground"
                    android:layout_width="match_parent"
                    android:layout_height="15dp"/>
                <com.lge.launcher3.smartbulletin.dslv.SBDragSortListView xmlns:dslv="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/smartbulletin_setting_list"
                    android:paddingTop="@dimen/smartbulletin_list_padding"
                    android:paddingBottom="@dimen/smartbulletin_list_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="0x20202d4"
                    android:divider="@drawable/listview_divider_background_with_checkbox"
                    android:fastScrollEnabled="true"
                    android:nestedScrollingEnabled="true"
                    dslv:drag_enabled="true"
                    dslv:drag_handle_id="@+id/drag_handle"
                    dslv:drag_scroll_start="0.33"
                    dslv:drag_start_mode="onDown"
                    dslv:float_alpha="0.9"
                    dslv:float_background_color="#ff8eedeb"
                    dslv:max_drag_scroll_speed="0.5"
                    dslv:remove_enabled="false"
                    dslv:slide_shuffle_speed="0.3"
                    dslv:sort_enabled="true"
                    dslv:track_drag_sort="false"
                    dslv:use_default_controller="true"/>
                <LinearLayout
                    android:background="?android:attr/colorForeground"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.lge.lgdynamicactionbar.CoordinatorLayout>
</LinearLayout>
