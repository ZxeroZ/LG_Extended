<?xml version="1.0" encoding="utf-8"?>
<com.lge.launcher3.wing.SystemShortcutView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_height="@dimen/system_shortcut_header_height_ux10_0"
    android:layout_weight="1">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/system_shortcut_icon_size_ux10_0"
        android:layout_height="@dimen/system_shortcut_icon_size_ux10_0"
        android:layout_marginTop="@dimen/system_shortcut_icon_padding_top_ux10_0"
        android:layout_marginBottom="@dimen/system_shortcut_icon_padding_bottom_ux10_0"
        android:scaleType="fitEnd"/>
    <TextView
        android:textSize="36px"
        android:textColor="@color/app_shortcut_text_color_black"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="-1.67dp"
        android:paddingStart="@dimen/system_shortcut_icon_padding_swivel"
        android:paddingEnd="@dimen/system_shortcut_icon_padding_swivel"/>
</com.lge.launcher3.wing.SystemShortcutView>
