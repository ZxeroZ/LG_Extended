<?xml version="1.0" encoding="utf-8"?>
<com.lge.launcher3.help.HelpPageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="0x20202d4">
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/information_layout"
            android:paddingTop="@dimen/help_title_top_padding"
            android:paddingBottom="@dimen/help_bottom_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/help_side_padding"
            android:paddingEnd="@dimen/help_side_padding">
            <ImageView
                android:id="@+id/initial_guide_page_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/help_img_desc_space_padding"
                android:adjustViewBounds="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="0.5dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/help_guide_padding_size"
                    android:layout_marginEnd="@dimen/help_guide_padding_size">
                    <TextView
                        android:id="@+id/initial_guide_page_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/help_title_desc_space_padding"
                        style="@style/help_title_font"/>
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:id="@+id/initial_guide_page_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/help_desc_sub_layout"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.lge.launcher3.help.HelpPageLayout>
