<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_card_surface"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/customize_colors"
        android:textColor="@color/color_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- SECCIÓN NORMAL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/normal_state"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/btnColorFondoNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/color_picker_item_bg"
        android:padding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_color"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnColorTextoNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/color_picker_item_bg"
        android:padding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/icon_text_color"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- SECCIÓN CARGANDO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/charging_state"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/btnColorFondoCargando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/color_picker_item_bg"
        android:padding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_color"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnColorTextoCargando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/color_picker_item_bg"
        android:padding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/icon_text_color"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- SECCIÓN BATERÍA BAJA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/low_battery_state"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/btnColorFondoBateriaBaja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/color_picker_item_bg"
        android:padding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_color"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnColorTextoBateriaBaja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/color_picker_item_bg"
        android:padding="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/icon_text_color"
            android:textColor="@color/color_text_primary"
            android:textSize="16sp"/>
    </LinearLayout>

</LinearLayout>
