<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#241f31">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iOS Style"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="16dp"/>

        <!-- CARD PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:elevation="4dp">

            <!-- Ícono de multitarea (Usa el que tienes o uno de Xposed) -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_ios"
                app:tint="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iOS-style multitasking"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Implements the 'recents' stack style, also known as iOS multitasking."
                android:textColor="#B0B0B0"
                android:textSize="14sp"
                android:gravity="center_horizontal"
                android:layout_marginBottom="16dp"/>

            <!-- Nota de Bugs como en la imagen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1AFFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bugs known:"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Scaling effect when using Quick Switch (Minor)"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- SWITCH PARA ACTIVAR/DESACTIVAR -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchIosRecents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Module"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:thumbTint="#4DB6AC"
                app:trackTint="#334DB6AC"/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go Back"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

</RelativeLayout>

